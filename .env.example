# ============================================
# Next.js Environment Variables Configuration
# ============================================
#
# REQUIRED: Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
#

# ============================================
# NextAuth.js Authentication Configuration
# ============================================

# REQUIRED: The canonical URL of your site - used for OAuth callbacks
# For development: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=

# REQUIRED: A random string used to hash tokens, sign/encrypt cookies and generate cryptographic keys
# Generate with: openssl rand -base64 32
# Must be at least 32 characters long
NEXTAUTH_SECRET=

# ============================================
# Google OAuth Configuration (Optional - for login)
# ============================================
#
# Get these from: https://console.cloud.google.com/
# 1. Create/select a project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID credentials
# 4. Set authorized redirect URI: [NEXTAUTH_URL]/api/auth/callback/google
# 5. Set authorized JavaScript origin: [NEXTAUTH_URL]

# Google OAuth Client ID (ends with .googleusercontent.com)
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# ============================================
# Site Configuration
# ============================================

# REQUIRED: Public site URL - used in SEO, meta tags, and WhatsApp links
# Must match your domain exactly
NEXT_PUBLIC_SITE_URL=

# ============================================
# Backend API Configuration
# ============================================

# REQUIRED: Backend API URL - for communicating with the backend services
# For development: http://localhost:4000/api/v1
# For production: https://your-api-domain.com/api/v1
NEXT_PUBLIC_API_URL=

# ============================================
# Optional: Database Configuration (if using database adapter)
# ============================================
#
# If you want to persist sessions/users in a database, uncomment and configure:
#
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
# Or for SQLite (simpler for development):
# DATABASE_URL="file:./dev.db"

# ============================================
# Optional: Email Configuration (if using email provider)
# ============================================
#
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@gmail.com
# EMAIL_SERVER_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com

# ============================================
# Optional: Redis Configuration (for session storage)
# ============================================
#
# REDIS_URL=redis://localhost:6379

# ============================================
# Development & Debugging (Optional)
# ============================================

# Enable React strict mode (default: true)
# NEXT_PUBLIC_STRICT_MODE=true

# Enable React concurrent features (default: true)
# NEXT_PUBLIC_CONCURRENT_FEATURES=true
